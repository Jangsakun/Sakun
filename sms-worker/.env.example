# 문자 워커 설정 — 이 파일을 같은 폴더에 ".env" 로 복사해서 값을 채웁니다.
# .env 는 Git 에 올라가지 않습니다. 이 PC 밖으로 보내지 마세요.

# 근태 앱 주소
SMS_API_BASE_URL=https://sakun.kr

# 근태 앱과 워커가 같이 쓰는 비밀값(32자 이상). Vercel 환경변수 SMS_WORKER_SECRET 에도 같은 값을 넣습니다.
SMS_WORKER_SECRET=

# 이 워커 이름(관리자 화면 표시용, 영문·숫자·-_.)
SMS_WORKER_ID=office-pc

# 1 = 모의 발송(뿌리오로 보내지 않고 성공 처리) / 0 = 실발송
SMS_DRY_RUN=1

# 대기열 확인 주기(초)
SMS_POLL_SECONDS=30

# 뿌리오 — 실발송(SMS_DRY_RUN=0)일 때 필요
PPURIO_ACCOUNT=
PPURIO_API_KEY=
PPURIO_FROM=
PPURIO_BASE_URL=https://message.ppurio.com
